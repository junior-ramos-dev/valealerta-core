# Copie as chaves para `.env.local` (dev) ou `.env.production.local` (build).
# Não coloque a anon key nos ficheiros abaixo — só URLs públicas.
#
#   npm run dev      → `.env.development`  (VITE_APP_URL = localhost:5173)
#   npm run build    → `.env.production`   (VITE_APP_URL = https://valealertasc.com.br)
#
# Sem VITE_SUPABASE_* o app fica no modo local (senha 123).

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
